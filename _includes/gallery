{% comment %}
  Custom gallery (overrides the theme's version):
  - images: click to enlarge, title shown as caption
  - videos: add `video: CLOUDINARY_ID` to an item for a silent looping clip
  - auto-compresses plain Cloudinary image URLs
  - optional params: height, shift, thumb_width, full_width
{% endcomment %}

{% if include.id %}
  {% assign gallery = page[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

{% if include.layout %}
  {% assign gallery_layout = include.layout %}
{% elsif gallery.size == 2 %}
  {% assign gallery_layout = 'half' %}
{% elsif gallery.size >= 3 %}
  {% assign gallery_layout = 'third' %}
{% else %}
  {% assign gallery_layout = '' %}
{% endif %}

{% assign thumb_w = include.thumb_width | default: 800 %}
{% assign full_w = include.full_width | default: 2000 %}
{% capture thumb_settings %}/upload/f_auto,q_auto,c_limit,w_{{ thumb_w }}/{% endcapture %}
{% capture full_settings %}/upload/f_auto,q_auto,c_limit,w_{{ full_w }}/{% endcapture %}
{% capture video_base %}https://res.cloudinary.com/uzoen9fy/video/upload/q_auto,w_{{ thumb_w }}{% endcapture %}

<figure class="{{ gallery_layout }} {{ include.class }}" style="--gallery-h: {{ include.height | default: '300px' }};{% if include.shift %} --shift: {{ include.shift }};{% endif %}{% if include.total_width %} --breakout-w: min(95vw, {{ include.total_width }});{% endif %}">
  {% for img in gallery %}
    {% assign label = img.caption | default: img.title %}

    {% if img.video %}
      {% comment %} ----- looping video item ----- {% endcomment %}
      <a class="gallery__item gallery__item--video">
        <video autoplay loop muted playsinline preload="metadata" poster="{{ video_base }}/{{ img.video }}.jpg">
          <source src="{{ video_base }},ac_none/{{ img.video }}.webm" type="video/webm">
          <source src="{{ video_base }},ac_none/{{ img.video }}.mp4" type="video/mp4">
        </video>
        {% if label %}
          <span class="gallery__caption">{{ label | markdownify | remove: "<p>" | remove: "</p>" }}</span>
        {% endif %}
      </a>

    {% else %}
      {% comment %} ----- image item ----- {% endcomment %}
      {% assign full = img.url | default: img.image_path %}
      {% assign thumb = img.image_path | default: img.url %}
      {% if full contains "res.cloudinary.com" and full contains "/upload/v" %}
        {% assign full = full | replace: "/upload/", full_settings %}
      {% endif %}
      {% if thumb contains "res.cloudinary.com" and thumb contains "/upload/v" %}
        {% assign thumb = thumb | replace: "/upload/", thumb_settings %}
      {% endif %}

      <a href="{{ full | relative_url }}" {% if img.title %}title="{{ img.title }}"{% endif %} class="gallery__item image-popup">
        <img src="{{ thumb | relative_url }}" alt="{{ img.alt }}">
        {% if label %}
          <span class="gallery__caption">{{ label | markdownify | remove: "<p>" | remove: "</p>" }}</span>
        {% endif %}
      </a>
    {% endif %}
  {% endfor %}

  {% if include.caption %}
    <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
  {% endif %}
</figure>